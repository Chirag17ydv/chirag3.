<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chirag | Cybersecurity Student</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #080e1e;
    color: white;
    font-family: Arial, sans-serif;
    line-height: 1.7;
}

/* HEADER */

header {
    background: #131f3a;
    padding: 20px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 42px;
    font-weight: bold;
}

.logo span,
.section-title span,
.hero h1 span {
    color: #08c8ed;
}

nav {
    margin-top: 15px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 18px;
}

nav a:hover {
    color: #08c8ed;
}

/* COMMON SECTIONS */

section {
    padding: 85px 6%;
}

.section-title {
    font-size: 50px;
    margin-bottom: 60px;
}

/* HOME */

.hero {
    min-height: 850px;
    background: linear-gradient(145deg, #080e1e, #14264a);
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.eyebrow {
    color: #a8b4ca;
    letter-spacing: 6px;
    font-weight: bold;
    margin-bottom: 35px;
}

.hero h1 {
    font-size: clamp(40px, 6vw, 65px);
    line-height: 1.2;
}

.hero p {
    max-width: 800px;
    color: #a8b4ca;
    font-size: 22px;
    margin: 35px 0;
}

.btn {
    display: inline-block;
    background: #08c8ed;
    color: #061322;
    padding: 16px 38px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 20px;
    font-weight: bold;
    border: none;
    cursor: pointer;
}

.btn:hover {
    background: #55dafa;
}

.hero-card {
    width: 100%;
    max-width: 750px;
    min-height: 370px;
    margin-top: 50px;
    border: 1px solid #08708c;
    border-radius: 30px;
    background: #131f3a;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.lock {
    font-size: 100px;
}

.hero-card h2 {
    font-size: 28px;
    line-height: 1.9;
}

.hero-card p {
    color: #08c8ed;
    font-size: 22px;
    margin: 15px;
}

/* ABOUT */

.about {
    background: #080e1e;
}

.profile-card {
    background: #131f3a;
    max-width: 380px;
    margin: auto;
    padding: 45px 20px;
    text-align: center;
    border-radius: 28px;
}

.avatar {
    height: 210px;
    width: 210px;
    margin: auto;
    border-radius: 50%;
    background: linear-gradient(135deg, #08c8ed, #5871ff);
    color: #071329;
    font-size: 100px;
    font-weight: bold;
    display: grid;
    place-items: center;
}

.profile-card h3 {
    font-size: 28px;
    margin-top: 25px;
}

.profile-card p {
    font-size: 20px;
}

.about-content {
    margin-top: 80px;
}

.about-content h3 {
    font-size: 28px;
    margin-bottom: 25px;
}

.about-content p {
    color: #a8b4ca;
    font-size: 21px;
}

/* PROJECTS */

.projects {
    background: #080d1b;
}

.project-card {
    background: #131f3a;
    border: 1px solid #263550;
    border-radius: 25px;
    padding: 40px;
    margin-bottom: 30px;
}

.project-card h3 {
    color: #08c8ed;
    font-size: 27px;
    margin-bottom: 20px;
}

.project-card p {
    color: #a8b4ca;
    font-size: 20px;
    margin-bottom: 25px;
}

.tag {
    display: inline-block;
    background: #263f68;
    color: #08c8ed;
    padding: 8px 20px;
    border-radius: 30px;
}

/* SKILLS */

.skill {
    margin-bottom: 40px;
}

.skill-name {
    display: flex;
    justify-content: space-between;
    font-size: 21px;
    margin-bottom: 15px;
}

.skill-name span:last-child {
    color: #08c8ed;
}

.progress {
    height: 17px;
    background: #202d49;
    border-radius: 30px;
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #08c8ed, #586cff);
    border-radius: 30px;
}

/* CONTACT */

.contact {
    background: #080d1b;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 20px;
    border: 1px solid #354665;
    border-radius: 15px;
    background: #131f3a;
    color: white;
    font-size: 19px;
    font-family: Arial, sans-serif;
    outline: none;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #08c8ed;
}

.contact-form textarea {
    resize: vertical;
    min-height: 150px;
}

.contact-form button {
    align-self: flex-start;
}

/* FOOTER */

footer {
    background: #131f3a;
    text-align: center;
    padding: 25px;
    color: #a8b4ca;
}

/* MOBILE RESPONSIVE */

@media (max-width: 700px) {

    header {
        padding: 15px 8px;
    }

    .logo {
        font-size: 36px;
    }

    nav {
        gap: 10px 18px;
    }

    nav a {
        font-size: 16px;
    }

    section {
        padding: 65px 6%;
    }

    .hero {
        min-height: auto;
        padding-top: 90px;
        padding-bottom: 70px;
    }

    .eyebrow {
        font-size: 13px;
        letter-spacing: 4px;
    }

    .hero p {
        font-size: 18px;
    }

    .hero-card {
        min-height: 320px;
    }

    .section-title {
        font-size: 40px;
    }

    .about-content p {
        font-size: 18px;
    }

    .project-card {
        padding: 28px;
    }

    .project-card h3 {
        font-size: 23px;
    }

    .project-card p {
        font-size: 18px;
    }
}
</style>
</head>

<body>

<!-- HEADER -->

<header id="home">
    <div class="logo">Chirag<span>.</span></div>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<!-- HOME SECTION -->

<section class="hero">

    <div class="eyebrow">CYBERSECURITY STUDENT</div>

    <h1>
        Building a Safer
        <span>Digital World.</span>
    </h1>

    <p>
        Hi, I'm Chirag, a BSc (Hons) Cybersecurity student.
        I am passionate about technology, programming,
        networking and cybersecurity.
    </p>

    <a href="#projects" class="btn">Explore My Work</a>

    <div class="hero-card">
        <div class="lock">🔐</div>

        <h2>
            Stay Curious.<br>
            Stay Secure.
        </h2>

        <p>Learn • Build • Secure</p>
    </div>

</section>

<!-- ABOUT SECTION -->

<section class="about" id="about">

    <h2 class="section-title">
        About <span>Me</span>
    </h2>

    <div class="profile-card">

        <div class="avatar">C</div>

        <h3>Chirag</h3>

        <p>Cybersecurity Student</p>

    </div>

    <div class="about-content">

        <h3>Who Am I?</h3>

        <p>
            I am currently pursuing BSc (Hons) Cybersecurity.
            I am learning HTML, CSS, Python, networking
            and cybersecurity fundamentals.
        </p>

        <p>
            My goal is to improve my technical knowledge
            and develop practical skills through projects.
        </p>

    </div>

</section>

<!-- PROJECTS SECTION -->

<section class="projects" id="projects">

    <h2 class="section-title">
        My <span>Projects</span>
    </h2>

    <div class="project-card">

        <h3>Portfolio Website</h3>

        <p>
            A responsive personal website created
            using HTML5 and advanced CSS3.
        </p>

        <span class="tag">HTML • CSS</span>

    </div>

    <div class="project-card">

        <h3>Password Checker</h3>

        <p>
            A beginner project to understand password
            length and character variety.
        </p>

        <span class="tag">Python • Security</span>

    </div>

    <div class="project-card">

        <h3>Network Ports</h3>

        <p>
            An informational project about common
            network ports and their uses.
        </p>

        <span class="tag">Networking</span>

    </div>

</section>

<!-- SKILLS SECTION -->

<section id="skills">

    <h2 class="section-title">
        Technical <span>Skills</span>
    </h2>

    <div class="skill">

        <div class="skill-name">
            <span>HTML5</span>
            <span>75%</span>
        </div>

        <div class="progress">
            <div class="progress-bar" style="width:75%"></div>
        </div>

    </div>

    <div class="skill">

        <div class="skill-name">
            <span>CSS3</span>
            <span>55%</span>
        </div>

        <div class="progress">
            <div class="progress-bar" style="width:55%"></div>
        </div>

    </div>

    <div class="skill">

        <div class="skill-name">
            <span>Python</span>
            <span>45%</span>
        </div>

        <div class="progress">
            <div class="progress-bar" style="width:45%"></div>
        </div>

    </div>

    <div class="skill">

        <div class="skill-name">
            <span>Cybersecurity</span>
            <span>50%</span>
        </div>

        <div class="progress">
            <div class="progress-bar" style="width:50%"></div>
        </div>

    </div>

</section>

<!-- CONTACT SECTION -->

<section class="contact" id="contact">

    <h2 class="section-title">
        Contact <span>Me</span>
    </h2>

    <form class="contact-form">

        <input
            type="text"
            name="name"
            placeholder="Your Name"
            required
        >

        <input
            type="email"
            name="email"
            placeholder="Your Email"
            required
        >

        <input
            type="tel"
            name="phone"
            placeholder="Your Phone Number"
        >

        <textarea
            name="message"
            placeholder="Write your message..."
            required
        ></textarea>

        <button type="submit" class="btn">
            Send Message
        </button>

    </form>

</section>

<!-- FOOTER -->

<footer>
    © 2026 Chirag. All Rights Reserved.
</footer>

</body>
</html>
